# Solo servidor: una base Neon exclusiva para la aplicación móvil.
NEON_MOBILE_DATABASE_URL=postgresql://USUARIO_MOVIL:CONTRASENA@HOST/aplicacion_movil?sslmode=require
# Opcional: conexión del sistema web original, únicamente para sus rutas antiguas.
# No reutilizar esa base para la aplicación móvil.
NEON_DATABASE_URL=
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_50_CARACTERES
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.77
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173,http://192.168.1.77:8081
FRONTEND_URL=http://localhost:5173

# Solo las rutas antiguas de la web utilizan el segundo factor por correo.
# La aplicación móvil registra su propia cuenta e inicia sesión con contraseña.
RESEND_API_KEY=REEMPLAZAR_EN_EL_SERVIDOR
RESEND_SENDER_NAME=Proyectos MEG
RESEND_SENDER_EMAIL=acceso@TU_DOMINIO_VERIFICADO
LEAD_MAGNET_RECEIVER_EMAIL=
BREVO_API_KEY=
BREVO_SENDER_NAME=Proyectos MEG
BREVO_SENDER_EMAIL=
CONTACT_RECEIVER_EMAIL=
SECURITY_RATE_LIMIT_ENABLED=True

# Producción: DEBUG=False, hosts y orígenes HTTPS reales.
# Activar únicamente si el proxy confiable controla la cabecera HTTPS.
TRUST_PROXY_HTTPS=False
SECURE_SSL_REDIRECT=False
