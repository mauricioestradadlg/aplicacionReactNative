{
  "expo": {
    "name": "Gestión de proyectos",
    "slug": "aplicacion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-meg.png",
    "scheme": "aplicacion",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/logo-meg.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#064CAA",
        "foregroundImage": "./assets/images/logo-meg.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/logo-meg.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1930",
          "image": "./assets/images/logo-meg.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
